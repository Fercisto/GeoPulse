# Copia este archivo como .env y ajusta los valores.
# .env NO se sube a git (contiene contraseñas).

# Base de datos (MySQL de Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=geopulse
DB_USER=root
DB_PASS=

# Clave para firmar los JWT. Genera una con:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CAMBIA_ESTA_CLAVE
# Duración del token en segundos (30 días)
JWT_TTL=2592000

# Gotify, visto desde este servidor (corre en la misma PC que Docker)
GOTIFY_URL=http://localhost:8080
GOTIFY_ADMIN_USER=admin
GOTIFY_ADMIN_PASS=

# Orígenes permitidos para CORS, separados por comas
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,https://localhost,capacitor://localhost
